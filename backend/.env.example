# Banco de dados (PostgreSQL em produção)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/helpdesk?schema=public"

# Autenticação
JWT_SECRET="troque-por-um-segredo-forte-em-producao"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=4400
CORS_ORIGIN="http://localhost:5173"

# E-mail (opcional — sem isso, o sistema salva os e-mails em dados/emails-enviados/ e loga no console)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE="Central de Ajuda <nao-responda@helpdesk.local>"
